#include <windows.h>
#include "resource.h"

IDI_APP ICON "../../assets/logo/lunar-logo-round.ico"
IDR_UI_HTML RCDATA "ui/index.html"
IDR_UI_LOGO RCDATA "../../assets/logo/lunar-logo-round-128.png"
IDR_UI_CRESCENT RCDATA "../../assets/logo/lunar-crescent-256.png"

1 24 "LunarDesktop.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Lunar"
      VALUE "FileDescription", "Lunar Desktop"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "Lunar Desktop"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "LunarDesktop.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
